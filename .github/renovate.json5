{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>CowDogMoo/renovate-config',
    'github>CowDogMoo/renovate-config:go',
  ],
  customManagers: [
    {
      description: 'Track git-tags versions in requirements.yaml',
      customType: 'regex',
      managerFilePatterns: ['/requirements\\.yaml$/'],
      matchStrings: [
        'name: (?<depName>\\S+)\\n\\s+src: (?<packageName>\\S+)\\n\\s+version: (?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'git-tags',
    },
  ],
}
